.kaggle
# Local Claude Code state stays ignored; the SessionStart hook and shared
# settings are committed so remote sessions get their environment prepared.
.claude/*
!.claude/settings.json
!.claude/hooks/
.venv
.pytest_cache/
.idea/


# Local data
replays/**
dist/**
decks/gen/**
checkpoints/**
data/**
data/kaggle/**
data/ppo
reference/
runs/**
pokemon-tcg-ai-battle
__pycache__/
# Rule-agent bundle: main.py + deck.csv are committed source; cg/ stays tracked
# (kept in-repo deliberately — fresh clones must be runnable; see
# docs/m43-ppo-pipeline-review.md) and rl/ is regenerated from the project by
# `rl.export --agent rules`.
submission_rules/rl/

# Competition-provided files: rules PDFs and the original card database.
# Downloaded via the Kaggle CLI, not committed (see README setup step 2).
*.pdf
data/EN_Card_Data.csv
events.out.*
submission/cg/**
# Kaggle episode-replay cache (rl/kaggle_ingest.py): immutable gzip blobs, can be
# hundreds of MB and are re-fetchable. The derived parquets/snapshots ARE committed.
data/kaggle/raw/
data/kaggle/logs/

# M7.3 generic-teacher BC shards: large, regenerable from the committed
# population.json (`python -m rl.bc collect --teacher generic`).
pokemon-tcg-ai-battle.zip
